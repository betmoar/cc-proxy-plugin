# API keys + proxy config. The installed plugin reads these from `~/.env`
# (the single source of truth); this repo-root `.env` is the dev/inline
# convenience (`claude --plugin-dir .` or `pnpm proxy`). `bin/cc-proxy.js`
# loads both via Node 22 `process.loadEnvFile`: repo `.env` first, then `~/.env`,
# and vars already in `process.env` (e.g. Claude Code's settings.json `env`)
# always win. `/cc-proxy:setup` writes only the two keys below to `~/.env`.
#
# `.env` is gitignored; never commit a real key.

# --- Backend keys (ALL optional) ---
# A backend is registered only when its key is present, so an absent key simply
# means that backend is unavailable — never a startup failure. Claude is OAuth
# and needs no key, so a proxy with zero keys still starts and routes there.
#
# Optional: Z.ai / GLM (https://z.ai -> Dashboard -> API Keys). When set, bare
# `glm-*` model ids route to Z.ai via x-api-key auth. Leave empty to disable.
# This is the model `/cc-proxy:setup` wires into the /model picker, so without
# it that picker entry has nowhere to route.
GLM_API_KEY=

# Optional: OpenRouter (Anthropic skin). When set, slash-namespaced model ids
# (e.g. anthropic/claude-opus-4, z-ai/glm-4.7) route to OpenRouter via Bearer
# auth. Leave empty to disable.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter model allowlist shown by GET /v1/models
# (comma-separated ids). When unset, a curated default of verified
# Anthropic-skin-compatible models is used. Only affects discovery, not routing.
OPENROUTER_MODELS=

# Optional: DeepSeek (Anthropic skin). When set, bare `deepseek-*` model ids
# (e.g. deepseek-v4-pro, deepseek-v4-flash) route to DeepSeek via x-api-key
# auth. Leave empty to disable.
DEEPSEEK_API_KEY=

# Optional: Qwen / QwenCloud (Anthropic skin, Token Plan). When set, bare
# `qwen`-prefixed model ids (e.g. qwen3.7-max, qwen3.6-flash) route to Qwen via
# Bearer auth. Leave empty to disable.
DASHSCOPE_API_KEY=

# Optional: LM Studio (self-hosted Anthropic skin). The BASE URL is the opt-in —
# it points at your server, e.g. http://mini.lan:1234 (enable "Serve on Local
# Network" in LM Studio; it binds loopback by default). No bare id routes there:
# local model names are arbitrary and churn with every load/unload, so reach it
# ONLY via the `lmstudio:<model-id>` selector, where <model-id> is the id GET
# /v1/models prints. LMSTUDIO_API_KEY is optional: set it when the server has
# "Require Authentication" on (sent as a Bearer token); with auth off a dummy
# token is sent, which the server ignores.
LMSTUDIO_BASE_URL=
LMSTUDIO_API_KEY=

# --- Proxy ---
# Listen port for the local proxy.
PROXY_PORT=4000
# Interface the proxy binds to. Loopback by default so the credential-injecting
# proxy isn't reachable from the LAN. Set to 0.0.0.0 only if you deliberately
# need off-host access.
PROXY_HOST=127.0.0.1
# Socket-inactivity timeout (ms) for upstream requests. Resets as bytes flow, so
# streaming token gaps are fine; it bounds a fully-stalled upstream. Default
# 120000. Raise it if you drive very large (1M-context) cold GLM calls whose
# time-to-first-byte can exceed two minutes.
PROXY_UPSTREAM_TIMEOUT_MS=120000
# Backend used when a request's model matches no prefix. "claude" or "glm".
DEFAULT_BACKEND=claude

# --- Logging / debug ---
# File the SessionStart hook redirects proxy stdout/stderr to. Defaults to
# ~/.claude/cc-proxy/cc-proxy.log (the hook creates the directory). Not /tmp:
# there another local user can pre-create the file as a symlink and our append
# follows it. The directory of whatever you set here must be writable.
# Leave empty to take the default: a literal ~ is NOT expanded by dotenv, so
# setting it here would create a directory actually named "~".
PROXY_LOG=
# Max log size (bytes) before the SessionStart hook rotates it to <log>.1 on the
# next spawn. Single generation. Default 5 MB (5242880).
PROXY_LOG_MAX_BYTES=5242880
# Set to 1 to log per-request metadata and routing detail.
PROXY_DEBUG=
