{
  "name": "cc-proxy-plugin",
  "private": true,
  "type": "module",
  "version": "0.8.2",
  "description": "GLM, DeepSeek, OpenRouter, Qwen, and LM Studio proxy for Claude Code — stateless local router with manual /model switching and per-provider auth.",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "cc-proxy": "./bin/cc-proxy.js"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node --test test/*.test.js",
    "check": "pnpm lint && pnpm test",
    "proxy": "node bin/cc-proxy.js",
    "models:html": "node scripts/render-html.mjs",
    "probe:vendors": "node scripts/probe-vendors.mjs",
    "sync-version": "node scripts/sync-version.mjs",
    "preversion": "node scripts/version-guard.js",
    "version": "node scripts/version-guard.js && node scripts/sync-version.mjs && git add .claude-plugin/plugin.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9"
  }
}
